# Copier vers docker/agent.env (hors dépôt), puis renseigner les valeurs. Aucun secret ici.
# chmod 600 docker/agent.env

# URL du serveur, préfixe compris (hébergé : https://allia-innovation.fr/espace/affichage).
VDS_SERVER_URL=http://192.168.1.182:8002

# Jeton affiché une seule fois à la création de l'agent dans l'admin (vds_agt_...).
VDS_AGENT_TOKEN=<COLLER_LE_JETON_ICI>

# Clé de chiffrement de l'état (jetons TV). Optionnel : sinon state.key est générée dans le volume.
# Recommandé en production : fournir la clé hors du volume de données (secret Docker),
# via VDS_AGENT_STATE_KEY_FILE=/run/secrets/vds_state_key (sinon avertissement agent.state_key_local).
# VDS_AGENT_STATE_KEY=<CLE_FERNET>

# DEV UNIQUEMENT : autorise http/ws en clair vers une IP privée (le jeton circule en clair).
# Retirer dès que le serveur est en HTTPS. Défaut : TLS obligatoire.
VDS_AGENT_INSECURE_DEV=1

# AC privée si serveur HTTPS interne (chemin dans le conteneur).
# VDS_AGENT_CA_FILE=/data/agent/ca.pem
