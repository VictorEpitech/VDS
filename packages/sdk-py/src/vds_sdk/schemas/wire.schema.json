{
  "$defs": {
    "AgentHeartbeat": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "$ref": "#/$defs/CacheStats",
          "default": {
            "bytes": 0,
            "enabled": false,
            "items": 0,
            "missing": 0
          }
        },
        "clock_offset_ms": {
          "default": 0,
          "title": "Clock Offset Ms",
          "type": "integer"
        },
        "modules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModuleStatus"
          },
          "title": "Modules",
          "type": "array"
        },
        "plan_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "screens": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScreenPower"
          },
          "title": "Screens",
          "type": "array"
        },
        "uptime_s": {
          "default": 0,
          "title": "Uptime S",
          "type": "integer"
        }
      },
      "title": "AgentHeartbeat",
      "type": "object"
    },
    "AgentHello": {
      "additionalProperties": false,
      "properties": {
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "core": {
          "title": "Core",
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostInfo"
        },
        "lan": {
          "$ref": "#/$defs/LanInfo",
          "default": {
            "ipv4": []
          }
        },
        "last_server_seq": {
          "default": 0,
          "minimum": 0,
          "title": "Last Server Seq",
          "type": "integer"
        },
        "modules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModuleRef"
          },
          "title": "Modules",
          "type": "array"
        },
        "out_seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Out Seq"
        }
      },
      "required": [
        "agent_version",
        "core",
        "host"
      ],
      "title": "AgentHello",
      "type": "object"
    },
    "AgentWelcome": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "format": "uuid",
          "title": "Agent Id",
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheInfo",
          "default": {
            "enabled": false,
            "key": null,
            "key_id": null
          }
        },
        "heartbeat_s": {
          "default": 30,
          "title": "Heartbeat S",
          "type": "integer"
        },
        "modules_enabled": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModuleEnabled"
          },
          "title": "Modules Enabled",
          "type": "array"
        },
        "plan_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "resume_from": {
          "default": 0,
          "minimum": 0,
          "title": "Resume From",
          "type": "integer"
        },
        "server_time": {
          "format": "date-time",
          "title": "Server Time",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "site_id": {
          "format": "uuid",
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "site_id",
        "session_id",
        "server_time"
      ],
      "title": "AgentWelcome",
      "type": "object"
    },
    "CacheInfo": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "key_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Id"
        }
      },
      "title": "CacheInfo",
      "type": "object"
    },
    "CacheStats": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "items": {
          "default": 0,
          "title": "Items",
          "type": "integer"
        },
        "missing": {
          "default": 0,
          "title": "Missing",
          "type": "integer"
        }
      },
      "title": "CacheStats",
      "type": "object"
    },
    "Cmd": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": true,
          "default": {},
          "title": "Args",
          "type": "object"
        },
        "cmd_id": {
          "format": "uuid",
          "title": "Cmd Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "screen_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screen Id"
        }
      },
      "required": [
        "cmd_id",
        "name",
        "expires_at"
      ],
      "title": "Cmd",
      "type": "object"
    },
    "CmdResult": {
      "additionalProperties": false,
      "properties": {
        "cmd_id": {
          "format": "uuid",
          "title": "Cmd Id",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "data": {
          "additionalProperties": true,
          "default": {},
          "title": "Data",
          "type": "object"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "expired",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "cmd_id",
        "status"
      ],
      "title": "CmdResult",
      "type": "object"
    },
    "EmptyArgs": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyArgs",
      "type": "object"
    },
    "EventData": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "default": {},
          "title": "Payload",
          "type": "object"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "occurred_at"
      ],
      "title": "EventData",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "ack": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ack"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "seq": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seq"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "type"
      ],
      "title": "Frame",
      "type": "object"
    },
    "HostInfo": {
      "additionalProperties": false,
      "properties": {
        "arch": {
          "title": "Arch",
          "type": "string"
        },
        "os": {
          "title": "Os",
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "title": "HostInfo",
      "type": "object"
    },
    "LanInfo": {
      "additionalProperties": false,
      "properties": {
        "ipv4": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ipv4",
          "type": "array"
        }
      },
      "title": "LanInfo",
      "type": "object"
    },
    "ModuleEnabled": {
      "additionalProperties": false,
      "properties": {
        "config_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Revision"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ModuleEnabled",
      "type": "object"
    },
    "ModuleRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ModuleRef",
      "type": "object"
    },
    "ModuleStatus": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "ModuleStatus",
      "type": "object"
    },
    "PlayerAuth": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "title": "PlayerAuth",
      "type": "object"
    },
    "PlayerCommandRef": {
      "additionalProperties": false,
      "description": "\u00c9l\u00e9ment de `commands` dans la r\u00e9ponse du heartbeat HTTP (m\u00eame contenu que la trame `cmd`).",
      "properties": {
        "args": {
          "additionalProperties": true,
          "default": {},
          "title": "Args",
          "type": "object"
        },
        "cmd_id": {
          "format": "uuid",
          "title": "Cmd Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "cmd_id",
        "name",
        "expires_at"
      ],
      "title": "PlayerCommandRef",
      "type": "object"
    },
    "PlayerHeartbeatAckExt": {
      "additionalProperties": false,
      "description": "Champs de la r\u00e9ponse du heartbeat HTTP (1.11).",
      "properties": {
        "commands": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlayerCommandRef"
          },
          "maxItems": 10,
          "title": "Commands",
          "type": "array"
        },
        "results_acked": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Results Acked",
          "type": "array"
        }
      },
      "title": "PlayerHeartbeatAckExt",
      "type": "object"
    },
    "PlayerHeartbeatExt": {
      "additionalProperties": false,
      "description": "Champs optionnels ajout\u00e9s par un player 1.11 \u00e0 sa requ\u00eate de heartbeat.",
      "properties": {
        "boot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boot Id"
        },
        "capabilities": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "cmd.reload",
                  "cmd.identify",
                  "cmd.screenshot",
                  "cmd.restart.app",
                  "cmd.restart.device",
                  "cmd.cache.resync"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capabilities"
        },
        "command_results": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CmdResult"
          },
          "maxItems": 20,
          "title": "Command Results",
          "type": "array"
        }
      },
      "title": "PlayerHeartbeatExt",
      "type": "object"
    },
    "PlayerWelcome": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "format": "uuid",
          "title": "Device Id",
          "type": "string"
        },
        "heartbeat_s": {
          "default": 60,
          "title": "Heartbeat S",
          "type": "integer"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "screen_id": {
          "format": "uuid",
          "title": "Screen Id",
          "type": "string"
        },
        "server_time": {
          "format": "date-time",
          "title": "Server Time",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "screen_id",
        "server_time"
      ],
      "title": "PlayerWelcome",
      "type": "object"
    },
    "PowerObserved": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "driver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        },
        "observed": {
          "enum": [
            "on",
            "off",
            "standby",
            "unknown"
          ],
          "title": "Observed",
          "type": "string"
        }
      },
      "required": [
        "observed"
      ],
      "title": "PowerObserved",
      "type": "object"
    },
    "RestartArgs": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "app",
            "device"
          ],
          "title": "Scope",
          "type": "string"
        },
        "via": {
          "default": "auto",
          "enum": [
            "auto",
            "player",
            "agent"
          ],
          "title": "Via",
          "type": "string"
        }
      },
      "required": [
        "scope"
      ],
      "title": "RestartArgs",
      "type": "object"
    },
    "ScheduleChanged": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "revision"
      ],
      "title": "ScheduleChanged",
      "type": "object"
    },
    "ScreenPower": {
      "additionalProperties": false,
      "properties": {
        "power": {
          "$ref": "#/$defs/PowerObserved"
        },
        "screen_id": {
          "format": "uuid",
          "title": "Screen Id",
          "type": "string"
        }
      },
      "required": [
        "screen_id",
        "power"
      ],
      "title": "ScreenPower",
      "type": "object"
    },
    "ScreenshotSchedule": {
      "additionalProperties": false,
      "description": "Champ optionnel `screenshot` de la programmation r\u00e9solue ; absent = d\u00e9sactiv\u00e9.",
      "properties": {
        "interval_min": {
          "maximum": 1440,
          "minimum": 5,
          "title": "Interval Min",
          "type": "integer"
        }
      },
      "required": [
        "interval_min"
      ],
      "title": "ScreenshotSchedule",
      "type": "object"
    }
  },
  "title": "vds wire v1",
  "x-agent-commands": [
    "power.set",
    "power.probe",
    "power.detect",
    "plan.updated",
    "config.updated",
    "cache.sync",
    "screen.provision",
    "discovery.scan",
    "apk.update",
    "app.restart"
  ],
  "x-player-commands": [
    "reload",
    "identify",
    "screenshot",
    "power.set",
    "power.probe",
    "restart",
    "cache.resync"
  ]
}
