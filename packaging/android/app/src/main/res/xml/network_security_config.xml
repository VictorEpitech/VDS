<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android ne filtre pas par plage IP : le clair est permis ici, mais RelayConfig.parse n'accepte que HTTPS,
         ou HTTP vers boucle locale / IP privée / .local (signalé player.insecure_upstream). -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
