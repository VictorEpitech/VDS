# /etc/vds/player.env (droits 0640 root:vds). Aucun secret : l'appairage se fait par code, dans le player.
VDS_PLAYER_URL=https://vds.example.fr/espace/affichage/player/
# Origine EXACTE du serveur (sans chemin ni barre finale) : seule servie par l'assistant local.
VDS_PI_ALLOWED_ORIGIN=https://vds.example.fr
# 1 = autoriser « Redémarrer l'appareil » depuis l'admin (capacité cmd.restart.device).
VDS_PI_ALLOW_REBOOT=0
