// Le seul utilisateur autorisé : "vds", et uniquement pour relancer vds-kiosk.service et redémarrer l'appareil.
// Le redémarrage de l'appareil n'est de toute façon proposé que si VDS_PI_ALLOW_REBOOT=1 (assistant).
polkit.addRule(function (action, subject) {
  if (subject.user !== "vds") return polkit.Result.NOT_HANDLED;
  if (action.id === "org.freedesktop.systemd1.manage-units" && action.lookup("unit") === "vds-kiosk.service" &&
      action.lookup("verb") === "restart") return polkit.Result.YES;
  if (action.id === "org.freedesktop.login1.reboot" || action.id === "org.freedesktop.login1.reboot-multiple-sessions")
    return polkit.Result.YES;
  return polkit.Result.NOT_HANDLED;
});
