{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048,
      "title": "item.content_rss.url.title",
      "description": "item.content_rss.url.description",
      "x-vds-level": "simple"
    },
    "max_items": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 10,
      "title": "item.content_rss.max_items.title",
      "description": "item.content_rss.max_items.description",
      "x-vds-level": "simple"
    },
    "display": {
      "type": "string",
      "enum": [
        "list",
        "ticker"
      ],
      "default": "list",
      "title": "item.content_rss.display.title",
      "description": "item.content_rss.display.description",
      "x-vds-level": "simple"
    },
    "item_duration_s": {
      "type": "integer",
      "default": 8,
      "minimum": 2,
      "maximum": 120,
      "title": "item.content_rss.item_duration_s.title",
      "description": "item.content_rss.item_duration_s.description",
      "x-vds-level": "advanced"
    },
    "show_date": {
      "type": "boolean",
      "default": true,
      "title": "item.content_rss.show_date.title",
      "description": "item.content_rss.show_date.description",
      "x-vds-level": "advanced"
    },
    "max_age_s": {
      "type": "integer",
      "default": 86400,
      "minimum": 600,
      "maximum": 604800,
      "title": "item.content_rss.max_age_s.title",
      "description": "item.content_rss.max_age_s.description",
      "x-vds-level": "advanced"
    }
  }
}
