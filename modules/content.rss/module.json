{
  "id": "content.rss",
  "version": "0.1.0",
  "core": ">=1.12 <2.0",
  "kind": "content-type",
  "name": {
    "fr": "Flux RSS",
    "en": "RSS feed"
  },
  "description": {
    "fr": "Affiche les titres d'un flux RSS ou Atom (texte seul). Le serveur récupère le flux ; le player garde le dernier état connu hors ligne.",
    "en": "Shows the headlines of an RSS or Atom feed (text only). The server fetches the feed; the player keeps the last known state offline."
  },
  "targets": [
    "server",
    "player",
    "admin"
  ],
  "entrypoints": {
    "server": "server.module:ContentRss"
  },
  "requires": {},
  "capabilities": [
    "content.rss"
  ],
  "permissions": [
    "net.outbound",
    "content.feeds"
  ],
  "events": {
    "listens": [],
    "emits": []
  },
  "config": {
    "$ref": "config.schema.json"
  },
  "assets": "assets",
  "content": {
    "item_schema": "item.schema.json",
    "player": {
      "element": "vds-content-rss",
      "script": "assets/player.js"
    },
    "requires_network": false
  },
  "i18n": [
    "fr",
    "en"
  ],
  "author": "V-Tech",
  "signature": null
}
