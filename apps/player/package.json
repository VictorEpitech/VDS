{
  "name": "@vds/player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.sw.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && node scripts/charte-check.mjs",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test",
    "e2e:real": "pnpm build && playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@vds/sdk-ts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.14.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
